# Copy this file to .env.local and fill in your key.
# Get a free key at https://aistudio.google.com/apikey
# Set it to "mock" to use a fake streaming model (no key, no quota).
GEMINI_API_KEY=

# Optional. Main model. Any Gemini text model id.
GEMINI_MODEL=gemini-flash-latest

# Optional. Backup models (comma-separated), tried in order when the main one
# is overloaded or out of free-tier quota.
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-2.5-flash
